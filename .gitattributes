# Preserve source bytes across Windows and Unix checkouts.
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.webmanifest text eol=lf
*.yml text eol=lf
*.command text eol=lf
*.bat text eol=crlf
*.min.js text eol=lf
*.zip binary
