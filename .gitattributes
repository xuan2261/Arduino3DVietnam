# Preserve source bytes across Windows and Unix checkouts.
.gitattributes text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.webmanifest text eol=lf
*.yml text eol=lf
*.command text eol=lf
*.bat text eol=crlf
*.min.js text eol=lf
assets/vendor/THREE-LICENSE.txt text eol=lf
assets/vendor/avr/avr8js-0.21.1-source/*.ts text eol=lf
# Exact upstream MIT-licensed timer.spec.ts includes trailing spaces in
# assembly fixtures. Keep its byte-for-byte Git blob/SHA-256 identity; exempt
# only that pinned reference file from trailing-space diff warnings.
assets/vendor/avr/avr8js-0.21.1-source/timer.spec.ts whitespace=-trailing-space
assets/vendor/avr/AVR8JS-LICENSE.txt text eol=lf
assets/vendor/avr/PROVENANCE.json text eol=lf
assets/firmware/manifest.json text eol=lf
*.zip binary
# Genuine avr-objcopy Intel HEX artifacts contain CRLF on all platforms.
# Git text normalization must not rewrite compiled bytes pinned by SHA-256.
assets/firmware/*.hex binary
